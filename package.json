{
  "name": "benchmark",
  "productName": "BenchMark",
  "version": "0.3.0",
  "description": "BenchMark \u2013 project KPI control for mining contractors",
  "author": "CORICA Mining Services",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/engine.test.ts tests/contractor.test.ts",
    "start": "npm run build && electron .",
    "make:sample": "node scripts/make-sample.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "test:server": "vitest run tests/server",
    "gen:sql": "node scripts/gen-sql.ts > supabase/migrations/20261029000000_benchmark.sql",
    "test:e2e:connected": "scripts/e2e-connected.sh",
    "test:e2e": "node tests/e2e.cjs && node tests/e2e-io.cjs && node tests/e2e-contractor.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "exceljs": "4.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.corica.benchmark",
    "productName": "BenchMark",
    "copyright": "CORICA Mining Services",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BenchMark",
      "artifactName": "BenchMark-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": null
  }
}
